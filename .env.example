VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPPORTOS_CLOUD_SYNC=false

# LiveChat monitoring: SERVER ONLY, never prefix secrets with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Telegram registration: SERVER ONLY. Add secrets in the hosting dashboard, never use VITE_.
TELEGRAM_BOT_USERNAME=GetSupportOSBot
TELEGRAM_BOT_TOKEN=
# Random 32+ character secret used to authenticate Telegram webhook requests.
TELEGRAM_WEBHOOK_SECRET=
# HTTPS origin for scripts/configure-telegram.mjs (no path/query, no trailing route).
SUPPORTOS_PUBLIC_URL=
LIVECHAT_AUTHORIZATION=
LIVECHAT_ORGANIZATION_ID=
LIVECHAT_WEBHOOK_SECRET=
MONITOR_COLLECTOR_SECRET=
# Used only on the always-on collector host:
MONITOR_URL=


# AI provider: openai or gemini. If omitted, OpenAI is preferred when configured.
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

SPORTS_BETTING_API_KEY=your-the-odds-api-key
SPORTS_BETTING_SPORTS=soccer_fifa_world_cup
SPORTS_BETTING_REGIONS=eu
SPORTS_BETTING_MARKETS=h2h
SPORTS_BETTING_LIMIT=12
SPORTS_BETTING_POLL_MS=7200000
SPORTS_BETTING_CACHE_TTL_SECONDS=7200
SPORTS_BETTING_INCLUDE_LAY=false
