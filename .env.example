VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPPORTOS_CLOUD_SYNC=false

# Supabase server credentials. Never prefix secrets with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional dedicated key for hashing IPs in security audit (32+ random characters).
# Without it, the server uses SUPABASE_SERVICE_ROLE_KEY. Never prefix with VITE_.
SECURITY_AUDIT_SECRET=
# Google OAuth Client ID and Secret belong in Supabase Auth > Providers > Google,
# not in the browser environment. Allow the site's /login callback in Supabase.
# Enable manual identity linking in Supabase to link Google to existing accounts.
# Chatwoot agent inbox integration (server only; never use VITE_ prefix).
CHATWOOT_BASE_URL=https://your-chatwoot.example.com
CHATWOOT_ACCOUNT_ID=
CHATWOOT_ACCESS_TOKEN=
# Optional server-only JSON map of SupportOS work emails to personal Chatwoot API tokens.
# Example shape: {"agent@example.com":"personal-token"}
CHATWOOT_AGENT_TOKENS=
# Optional server-only Platform App credential and work email for one authorized pilot agent.
# Use Chatwoot 4.20.0 or newer for scoped Platform App permissions on existing users.
CHATWOOT_PLATFORM_APP_TOKEN=
CHATWOOT_PLATFORM_PILOT_EMAIL=

# Gmail workspace OAuth. Separate from the SupportOS sign-in configuration. Server only.
MAIL_GOOGLE_CLIENT_ID=
MAIL_GOOGLE_CLIENT_SECRET=
MAIL_GOOGLE_REDIRECT_URL=https://your-supportos.example.com/api/mail/callback
MAIL_ENCRYPTION_KEY=


# AI provider: openai or gemini. If omitted, OpenAI is preferred when configured.
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

SPORTS_BETTING_API_KEY=your-the-odds-api-key
SPORTS_BETTING_SPORTS=soccer_fifa_world_cup
SPORTS_BETTING_REGIONS=eu
SPORTS_BETTING_MARKETS=h2h
SPORTS_BETTING_LIMIT=12
SPORTS_BETTING_POLL_MS=7200000
SPORTS_BETTING_CACHE_TTL_SECONDS=7200
SPORTS_BETTING_INCLUDE_LAY=false
